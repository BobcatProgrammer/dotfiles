{ config, pkgs, lib, ... }:

let
  isDarwin = pkgs.stdenv.hostPlatform.isDarwin;
  isLinux = pkgs.stdenv.hostPlatform.isLinux;

  # Nerd Font used by alacritty/tmux/zellij configs. macOS keeps the brew
  # casks (font dirs there are handled by the OS); Linux installs via nix.
  hackFont = pkgs.nerd-fonts.hack;

  # CLI tools: identical on macOS and Linux.
  # Everything here was formerly installed via Homebrew / asdf.
  cli = with pkgs; [
    age
    bat
    bitwarden-cli
    curl
    direnv
    eza
    fd
    fish
    fluxcd
    fzf
    gh
    git
    gitleaks
    go
    google-cloud-sdk
    jq
    k9s
    kubectl
    kubectx
    kustomize
    lazygit
    neovim
    nmap
    nodejs
    php
    phpPackages.composer
    pnpm
    podman
    podman-compose
    pre-commit
    ripgrep
    scc
    sesh
    sops
    terraform
    terraform-docs
    tflint
    tmux
    tmuxinator
    tree
    uv
    wget
    yq
    zellij
    zoxide
  ];

  # macOS-only packages.
  # Validation on the Mac may bounce insomnia back to the residual Brewfile
  # if its nixpkgs darwin build fails.
  darwin = with pkgs; [
    bash # modern bash: macOS ships 3.2
    mas # App Store CLI (used by the chezmoi mas-install script)
    rectangle
    insomnia
    (vscode-with-extensions.override {
      vscodeExtensions = with vscode-extensions; [
        aaron-bond.better-comments
        editorconfig.editorconfig
        bradlc.vscode-tailwindcss
        dbaeumer.vscode-eslint
        davidanson.vscode-markdownlint
        golang.go
        github.vscode-pull-request-github
        github.vscode-github-actions
        github.github-vscode-theme
        github.copilot
        github.copilot-chat
        hashicorp.terraform
        redhat.vscode-yaml
        timonwong.shellcheck
        vscode-icons-team.vscode-icons
      ];
    })
  ];

  # Linux-only packages.
  linux = with pkgs; [
    fontconfig # provides fc-list/fc-cache
    hackFont
    util-linux # provides script(1) (PTY smoke tests, etc.)
  ];
in
{
  home.username = "{{ .chezmoi.username }}";
  home.homeDirectory = "{{ .chezmoi.homeDir }}";

  home.stateVersion = "26.05";

  home.packages = cli ++ lib.optionals isDarwin darwin ++ lib.optionals isLinux linux;

  # Expose the nix-installed Nerd Font to fontconfig on Linux.
  home.file = lib.mkIf isLinux {
    ".local/share/fonts/NerdFonts".source = "${hackFont}/share/fonts/truetype/NerdFonts";
  };

  fonts.fontconfig = lib.mkIf isLinux {
    enable = true;
  };

  home.sessionVariables = {
    EDITOR = "vim";
  };

  programs.home-manager.enable = true;
}
