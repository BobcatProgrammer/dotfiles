{
  description = "Trockels Home Manager configuration";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    omp.url = "github:can1357/oh-my-pi";
  };

  outputs = { nixpkgs, home-manager, omp, ... }:
    let
      # Current machines are Apple Silicon / Asahi Linux (aarch64).
      # Add x86_64 branches here if an Intel machine joins.
      # .chezmoi.arch: arm64 (Apple Silicon/Asahi) or amd64 (Intel/x86 CI).
      system = "{{ if eq .chezmoi.arch "arm64" }}aarch64{{ else }}x86_64{{ end }}-{{ if eq .chezmoi.os "darwin" }}darwin{{ else }}linux{{ end }}";
      # import nixpkgs directly (not legacyPackages) so nixpkgs.config applies;
      # allowUnfree covers terraform (BSL), vscode, etc.
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };
      lib = nixpkgs.lib;
    in
    {
      homeConfigurations."{{ .chezmoi.username }}" =
        home-manager.lib.homeManagerConfiguration {
          inherit pkgs;

          extraSpecialArgs = {
            inherit omp;
          };

          # omp (oh-my-pi harness shell) is Linux-only for now.
          modules = [ ./home.nix ] ++ lib.optionals (!pkgs.stdenv.hostPlatform.isDarwin) [ ./omp.nix ];
        };
    };
}
