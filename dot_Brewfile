# ~/.Brewfile — macOS-only residual
#
# Everything else is managed by home-manager from the nixpkgs flake
# (dot_config/home-manager/home.nix). Add packages here ONLY if they have
# no working nixpkgs equivalent. Homebrew no longer installs CLI tools.

tap "slp/krunkit"

# nixpkgs has no darwin build for these
brew "krunkit"

cask "raycast"
cask "logi-options+"
cask "podman-desktop"
cask "signal"

# Nerd fonts (nixpkgs nerd-fonts lacks the caskaydia variants)
cask "font-hack-nerd-font"
cask "font-caskaydia-cove-nerd-font"
cask "font-caskaydia-mono-nerd-font"
